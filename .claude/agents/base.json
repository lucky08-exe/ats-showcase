{
  "$schema": "agent-config-schema",
  "description": "Default role configurations. Individual role .md files reference and may override.",
  "roles": {
    "architect": {
      "model": "claude-sonnet-5",
      "name": "Architect/Planner",
      "tools": {
        "allowed": [
          "Read",
          "Write",
          "Grep",
          "Glob",
          "Bash(gh issue create)",
          "Bash(gh issue list)",
          "Bash(gh issue comment)",
          "Bash(graphify query *)",
          "Bash(graphify path *)",
          "Bash(graphify explain *)",
          "Bash(code-review-graph query *)",
          "Bash(code-review-graph impact *)",
          "Bash(code-review-graph architecture)"
        ],
        "denied": [
          "Bash(rm *)",
          "Bash(git push *)"
        ],
        "patterns": {
          "read": [
            "CLAUDE.md",
            "AGENTS.md",
            "tasks.md",
            "DESIGN.md",
            ".claude/**"
          ],
          "write": [
            "tasks.md",
            "docs/**"
          ],
          "edit": []
        }
      },
      "responsibilities": [
        "Draft implementation plans (tasks.md)",
        "Design module boundaries + APIs",
        "Write architectural decisions",
        "Define phase coordination (multi-agent.md)"
      ],
      "constraints": [
        "NEVER: Write production code (src/, tests/)",
        "NEVER: Modify CLAUDE.md, AGENTS.md without human review",
        "ALWAYS: Gate 1 approval before cross-file changes"
      ]
    },
    "builder": {
      "model": "claude-haiku-4-5-20251001",
      "name": "Builder/Implementer",
      "tools": {
        "allowed": [
          "Read",
          "Write",
          "Edit",
          "Bash(uv *)",
          "Bash(pytest *)"
        ],
        "denied": [
          "Bash(rm -rf *)",
          "Bash(git reset *)",
          "Bash(git push --force *)"
        ],
        "patterns": {
          "read": [
            "src/**",
            "tests/**",
            ".claude/rules/**"
          ],
          "write": [
            "src/**",
            "tests/**"
          ],
          "edit": [
            "src/**",
            "tests/**"
          ],
          "bash": [
            "uv sync",
            "uv run",
            "pytest",
            "ruff",
            "black"
          ]
        }
      },
      "responsibilities": [
        "Implement features per tasks.md",
        "Write and run tests",
        "Create feature branch commits",
        "Flag design issues to Architect"
      ],
      "constraints": [
        "NEVER: Modify tasks.md, CLAUDE.md, AGENTS.md, .claude/settings.json",
        "NEVER: Skip tests or commit without local CI passing",
        "ALWAYS: Reference phase rules (.claude/rules/*.md)",
        "ALWAYS: Use feature branches (feat/issue-XXX-*)"
      ]
    },
    "reviewer": {
      "model": "claude-haiku-4-5-20251001",
      "name": "Reviewer/Tester",
      "tools": {
        "allowed": [
          "Read",
          "Bash(pytest *)",
          "Bash(ruff *)",
          "Bash(grep *)"
        ],
        "denied": [
          "Write",
          "Edit",
          "Bash(rm *)",
          "Bash(git push *)"
        ],
        "patterns": {
          "read": [
            "**"
          ],
          "bash": [
            "pytest",
            "ruff",
            "black",
            "mypy",
            "grep",
            "find",
            "ls"
          ]
        }
      },
      "responsibilities": [
        "Verify implementation vs tasks.md",
        "Run full test suite (pytest, coverage, lint)",
        "Check code quality + type safety (mypy)",
        "Gate 2 evidence-based verification"
      ],
      "constraints": [
        "NEVER: Modify production code or merge without human approval",
        "ALWAYS: Use actual tool output (not predictions) for verification",
        "ALWAYS: Test coverage > 80% for new code"
      ]
    },
    "slop-hunter": {
      "model": "claude-sonnet-5",
      "name": "Dead Code & Doc Slop Hunter",
      "tools": {
        "allowed": [
          "Read",
          "Grep",
          "Glob",
          "Bash(code-review-graph dead-code)",
          "Bash(code-review-graph query *)",
          "Bash(code-review-graph impact *)",
          "Bash(code-review-graph large-functions)",
          "Bash(graphify query *)",
          "Bash(graphify path *)",
          "Bash(graphify explain *)",
          "Bash(gh issue create)",
          "Bash(gh issue list)"
        ],
        "denied": [
          "Write",
          "Edit"
        ]
      },
      "responsibilities": [
        "Find unreferenced code via code-review-graph dead-code",
        "Flag stale commented-out blocks",
        "Propose 1-2 file sub-issues, one at a time"
      ],
      "constraints": [
        "NEVER: Edit files (report only)",
        "ALWAYS: Respect dead-code exclusions in slop-hunter.md"
      ]
    },
    "cavecrew-builder": {
      "model": "claude-haiku-4-5",
      "name": "Cleanup Builder",
      "tools": {
        "allowed": [
          "Read",
          "Edit",
          "Grep",
          "Glob",
          "Bash(git diff *)",
          "Bash(git status)",
          "Bash(uv run pytest *)",
          "Bash(uv run ruff *)",
          "Bash(uv run mypy *)",
          "Bash(bash .claude/scripts/run-local-ci.sh *)"
        ],
        "denied": [
          "Bash(rm -rf *)",
          "Bash(git reset --hard*)",
          "Bash(git push --force*)"
        ],
        "patterns": {
          "edit": [
            "src/**",
            "tests/**",
            "docs/**"
          ],
          "deny": [
            "AGENTS.md",
            "CLAUDE.md",
            ".claude/agents/**",
            ".claude/rules/**",
            ".claude/skills/**",
            ".claude/settings.json",
            "tasks.md"
          ]
        }
      },
      "responsibilities": [
        "Apply approved single-issue dead-code cleanup",
        "Run local CI with tests before reporting done"
      ],
      "constraints": [
        "NEVER: Modify more than 2 files per execution",
        "NEVER: Modify tasks.md, CLAUDE.md, AGENTS.md, .claude/**"
      ]
    },
    "cavecrew-reviewer": {
      "model": "claude-haiku-4-5",
      "name": "Cleanup Reviewer",
      "tools": {
        "allowed": [
          "Read",
          "Grep",
          "Bash(git diff *)",
          "Bash(git status)",
          "Bash(code-review-graph detect-changes *)",
          "Bash(code-review-graph impact *)",
          "Bash(code-review-graph dead-code)",
          "Bash(uv run ruff *)",
          "Bash(uv run mypy *)",
          "Bash(uv run pytest *)"
        ],
        "denied": [
          "Write",
          "Edit"
        ]
      },
      "responsibilities": [
        "Blast-radius and orphan checks on cleanup diffs",
        "Gatekeeper with max 4 review loops"
      ],
      "constraints": [
        "NEVER: Modify production code",
        "ALWAYS: Escalate to human at loop 4 without convergence"
      ]
    }
  },
  "defaults": {
    "pythonVersion": "3.11+",
    "testFramework": "pytest",
    "linter": "ruff",
    "typeChecker": "mypy",
    "tokenBudget": {
      "claude-sonnet-5": 200000,
      "claude-haiku-4-5-20251001": 200000
    }
  },
  "phases": {
    "crawl": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/crawl.md",
      "appliesTo": [
        "src/browser/**",
        "src/parsers/**"
      ]
    },
    "preprocess": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/preprocess.md",
      "appliesTo": [
        "src/tokenization/**",
        "src/parsers/**"
      ]
    },
    "verify": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/verify.md",
      "appliesTo": [
        "src/cli/**"
      ]
    },
    "assess": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/assess.md",
      "appliesTo": [
        "src/llm/**",
        "src/assessment/**"
      ]
    },
    "storage": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/storage.md",
      "appliesTo": [
        "src/storage/**"
      ]
    },
    "tui": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/tui/",
      "appliesTo": [
        "src/tui/**"
      ]
    },
    "coordination": {
      "ownerRole": "architect",
      "reviewerRole": "human",
      "rules": ".claude/rules/multi-agent.md",
      "appliesTo": [
        "tasks.md",
        ".claude/**"
      ]
    }
  },
  "handoverProtocol": "ARCHITECT → BUILDER → REVIEWER → HUMAN (merge)",
  "gates": {
    "gate1": {
      "stage": "Before implementation",
      "triggers": [
        "module interface changes",
        "config file changes",
        "CLI changes",
        "schema migrations"
      ],
      "checklist": [
        "Architect drafts tasks.md with API contracts",
        "Architect sketches affected files (list + scope)",
        "Human/team reviews and approves"
      ]
    },
    "gate2": {
      "stage": "Before merge",
      "triggers": [
        "All multi-file changes"
      ],
      "checklist": [
        "All tests passing (pytest)",
        "Linter passing (ruff/black)",
        "Type checker passing (mypy)",
        "Build succeeds",
        "Reviewer approves with evidence-based verification"
      ]
    }
  },
  "lastUpdated": "2026-08-09",
  "version": "1.0"
}
